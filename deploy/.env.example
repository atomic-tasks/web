# Прод: скопируйте в /opt/atomic-tasks-web/.env на сервере, chmod 600. Подробно — docs/deploy.md.
# Значения со скобками <...> заменить. Секретов здесь нет — только адреса и имена Traefik.

# Сайт; тот же WEB_HOST, что в .env бэкенда (его /api/ Traefik отдаёт бэкенду)
WEB_HOST=<atomic.example.com>
# Внешняя сеть Traefik: docker network ls (та же, что у бэкенда)
TRAEFIK_NETWORK=<traefik>
# Имена из статического конфига Traefik (entryPoints и certificatesResolvers)
TRAEFIK_ENTRYPOINT=<websecure>
TRAEFIK_CERTRESOLVER=<letsencrypt>
# Образ; по умолчанию ghcr.io/atomic-tasks/web
#IMAGE=ghcr.io/atomic-tasks/web
