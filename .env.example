# Скопируй в .env.local (не коммитится). Читается только dev-сервером Vite и в бандл не попадает.

# Адрес бэкенда для dev-прокси (/api, /health)
ATOMIC_API_URL=http://localhost:8000

# Personal access token (at_...) для локальной разработки, пока нет входа через cookie (ADR 0003).
# Создать: http://localhost:8000/docs → Authorize → POST /api/v1/tokens
ATOMIC_DEV_TOKEN=
